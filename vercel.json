{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@8.2"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|user|dist|unpkg.com|w|.*\\.mp3|.*\\.ico|.*\\.png|.*\\.gif|.*\\.txt)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
