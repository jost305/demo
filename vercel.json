{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/(css|js|images|user|dist|unpkg\\.com|w)/(.*)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/(.+\\.(ico|png|gif|mp3|txt|svg|woff2?|ttf|eot))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
